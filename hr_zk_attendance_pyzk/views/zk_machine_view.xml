<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zk_machine_form" model="ir.ui.view">
        <field name="name">zk.machine.form</field>
        <field name="model">zk.machine</field>
        <field name="arch" type="xml">
            <form string="Biometric Device">
                <header>
                    <button name="try_connection" type="object" string="Test Connection"
                            class="oe_highlight" icon="fa-plug"/>

                    <button name="download_attendance" type="object" string="Download Data"
                            class="btn-primary" icon="fa-download"/>

                    <button name="download_attendance" type="object" string="Re-Download Data"
                            context="{'recalc': True}" icon="fa-refresh"/>

                    <button name="clear_attendance" type="object" string="Clear Data"
                            confirm="Are you sure you want to delete all data from the device?"
                            icon="fa-trash" class="btn-danger"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Machine IP (e.g. 192.168.1.201)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="port_no"/>
                            <field name="zk_timeout"/>
                            <field name="zk_after_date"/>
                            <field name="address_id" string="Working Address"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zk_machine_list" model="ir.ui.view">
        <field name="name">zk.machine.list</field>
        <field name="model">zk.machine</field>
        <field name="arch" type="xml">
            <tree string="Biometric Machines">
                <field name="name" string="IP Address"/>
                <field name="port_no"/>
                <field name="address_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="zk_machine_action" model="ir.actions.act_window">
        <field name="name">Biometric Devices</field>
        <field name="res_model">zk.machine</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="hr_employee_inherit_form_view" model="ir.ui.view">
        <field name="name">hr.employee.inherit.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='identification_id']" position="after">
                <field name="device_id"/>
            </xpath>
        </field>
    </record>

    <menuitem id="zk_machine_menu" parent="hr_attendance.menu_hr_attendance_root" sequence="50"
              name="Biometric Manager"/>
    <menuitem id="zk_machine_sub_menu" parent="zk_machine_menu" name="Devices" action="zk_machine_action"
              sequence="1"/>
</odoo>