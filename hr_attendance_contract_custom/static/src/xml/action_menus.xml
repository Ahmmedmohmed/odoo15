<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ActionMenus" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-esc='item.description']" position="before">
            <i t-if="item.description === ' Calculate'" class="fa fa-calculator mr-2 text-primary"/>
        </xpath>
    </t>

</templates>